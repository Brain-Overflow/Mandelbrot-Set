{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main (CMake build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mandelbrot",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "description": "Enable pretty-printing for gdb",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}